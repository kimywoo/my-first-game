    player = pygame.Rect(WIDTH//2 - 20, HEIGHT - 160, 40, 40)
    bullets, missiles, enemies, explosions = [], [], [], []

    boss1, boss1_hp, boss1_max, boss1_bombs, boss1_timer = None, 35, 35, [], 0
    boss2, boss2_hp, boss2_max, boss2_bombs, boss2_timer, boss2_dir = None, 50, 50, [], 0, 1
    final_boss, final_hp, final_max, final_bullets, final_missiles, final_timer = None, 80, 80, [], [], 0

    # 호위 전투기: [rect, state, speed_y, hp]
    # state: 'idle'(보스 옆 대기) / 'charge'(돌진 중) / 'return'(복귀 중)
    escort_jets = []   # 최대 2대
    escort_cd  = 0     # 호위기 발진 쿨다운

    boss1_spawned = boss2_spawned = final_spawned = False
    final_warning_shown = False
    score, lives = 0, 5
    shoot_cd = skill_cd = shield_cd = shield = 0
    invul_timer = 0
    ani_timer = ani_idx = 0

    sand_particles = [[random.randint(0, WIDTH), random.randint(0, HEIGHT), random.randint(3, 7)] for _ in range(120)]

    was_moving = False

    play_bgm()

    while True:
        dt = clock.tick(FPS)
        moving = False

        for e in pygame.event.get():
            if e.type == pygame.QUIT: pygame.quit(); sys.exit()

        keys = pygame.key.get_pressed()
        SPEED = 9  # 플레이어 속도 증가
        if keys[pygame.K_LEFT]  and player.left  > 0:      player.x -= SPEED; moving = True
        if keys[pygame.K_RIGHT] and player.right  < WIDTH:  player.x += SPEED; moving = True
        if keys[pygame.K_UP]    and player.top    > 0:      player.y -= SPEED; moving = True
        if keys[pygame.K_DOWN]  and player.bottom < HEIGHT: player.y += SPEED; moving = True

        # 탱크 이동 효과음 (루프)
        if snd_tankmove and tankmove_channel:
            if moving and not was_moving:
                tankmove_channel.play(snd_tankmove, loops=-1)
            elif not moving and was_moving:
                tankmove_channel.stop()
        was_moving = moving

        ani_timer += dt
        if ani_timer > 120: ani_idx, ani_timer = (ani_idx + 1) % 4, 0

        for p in sand_particles:
            p[1] += p[2]
            if p[1] > HEIGHT: p[1], p[0] = -10, random.randint(0, WIDTH)

        shoot_cd -= 1; skill_cd -= 1; shield_cd -= 1; shield -= 1
        if invul_timer > 0: invul_timer -= 1

        if keys[pygame.K_SPACE] and shoot_cd <= 0:
            bullets.append(pygame.Rect(player.centerx-3, player.top, 6, 14))
            shoot_cd = 10
            # 전용 채널로 재생 - 이전 소리가 끝났을 때만 재생해 중첩 방지
            if snd_ammo and ammo_channel and not ammo_channel.get_busy():
                ammo_channel.play(snd_ammo)

        if keys[pygame.K_e] and skill_cd <= 0:
            missiles.append(pygame.Rect(player.centerx-15, player.top, 30, 60))
            skill_cd = FPS * 12
            if snd_missile:
                snd_missile.play()

        if keys[pygame.K_f] and shield_cd <= 0:
            shield, shield_cd = FPS * 3, FPS * 10

        level = score // 60 + 1

        # 보스 스폰
        if level >= 5 and level < 10 and not boss1_spawned:
            enemies.clear()
            boss1 = pygame.Rect(WIDTH//2 - 200, 40, 400, 280)
            boss1_spawned = True

        if level >= 10 and level < 15 and not boss2_spawned:
            enemies.clear(); boss1 = None
            boss2 = pygame.Rect(WIDTH//2 - 210, 50, 420, 300)
            boss2_spawned = True

        if level >= 15 and not final_spawned:
            enemies.clear(); boss2 = None
            if not final_warning_shown:
                if tankmove_channel:
                    tankmove_channel.stop()
                show_final_boss_warning()
                final_warning_shown = True
            final_boss = pygame.Rect(WIDTH//2 - 180, 60, 360, 300)
            final_spawned = True

        if not (boss1 or boss2 or final_boss):
            if random.random() < 0.02:
                enemies.append(pygame.Rect(random.randint(0, WIDTH-80), -80, 80, 80))

        # 이동
        for b in bullets[:]: b.y -= 10
        for m in missiles[:]: m.y -= 5
        for e in enemies[:]: e.y += 2

        # 보스1 - 5발 부채꼴
        if boss1:
            boss1_timer += 1
            if boss1_timer % 90 == 0:
                angles = [-2.5, -1.2, 0, 1.2, 2.5]
                for dx in angles:
                    boss1_bombs.append([pygame.Rect(boss1.centerx-10, boss1.bottom-80, 20, 20), dx, 5])

        # 보스2 - 이동 폭 제한 (화면 밖 나가지 않게)
        if boss2:
            boss2.x += boss2_dir * 3.5
            if boss2.left < 50: boss2.left = 50; boss2_dir = 1
            if boss2.right > WIDTH - 50: boss2.right = WIDTH - 50; boss2_dir = -1
            boss2_timer += 1
            if boss2_timer % 40 == 0:
                boss2_bombs.append([pygame.Rect(boss2.centerx, boss2.bottom - 50, 15, 15), 0, 6])

        if final_boss:
            final_timer += 1
            final_boss.centerx = WIDTH // 2 + math.sin(final_timer * 0.02) * 200
            if final_timer % 30 == 0:
                final_bullets.append([pygame.Rect(random.randint(final_boss.left, final_boss.right), final_boss.bottom - 50, 12, 12), 0, 7])
            if final_timer % 120 == 0:
                final_missiles.append([pygame.Rect(final_boss.centerx-10, final_boss.bottom - 80, 20, 40), 0, 4])

            # 호위 전투기 발진 (180프레임마다, 최대 2대 동시)
            escort_cd -= 1
            if escort_cd <= 0 and len(escort_jets) < 2:
                escort_cd = 180
                # 왼쪽, 오른쪽 각각 발진
                for side in [-1, 1]:
                    ex = final_boss.centerx + side * 280
                    ey = final_boss.centery
                    escort_jets.append({
                        'rect': pygame.Rect(ex - 100, ey - 100, 200, 200),
                        'state': 'charge',
                        'vy': 7,          # 돌진 속도
                        'hp': 3,
                        'side': side,
                    })

            # 호위기 업데이트
            for jet in escort_jets[:]:
                if jet['state'] == 'charge':
                    jet['rect'].y += jet['vy']
                    # 화면 밖으로 나가면 제거
                    if jet['rect'].top > HEIGHT + 50:
                        escort_jets.remove(jet)
                        continue
                # 보스 옆 위치로 X 동기화 (보스가 좌우로 움직이므로)
                if jet['state'] == 'charge':
                    jet['rect'].centerx = final_boss.centerx + jet['side'] * 280

        for b_data in boss1_bombs: b_data[0].x += b_data[1]; b_data[0].y += b_data[2]
        for b_data in boss2_bombs: b_data[0].y += b_data[2]
        for b_data in final_bullets: b_data[0].y += b_data[2]
        for b_data in final_missiles: b_data[0].y += b_data[2]

        # 충돌
        if invul_timer <= 0:
            for d in enemies + [b[0] for b in boss1_bombs] + [b[0] for b in boss2_bombs] + [b[0] for b in final_bullets] + [b[0] for b in final_missiles]:
                if d.colliderect(player):
                    if shield <= 0: lives -= 1; invul_timer = FPS
                    if d in enemies: enemies.remove(d)
                    break
            # 호위기 충돌
            for jet in escort_jets[:]:
                if jet['rect'].colliderect(player):
                    if shield <= 0: lives -= 1; invul_timer = FPS
                    break

        for b in bullets[:]:
            hit_boss = False
            if boss1 and b.colliderect(boss1): boss1_hp -= 1; hit_boss = True
            elif boss2 and b.colliderect(boss2): boss2_hp -= 1; hit_boss = True
            elif final_boss and b.colliderect(final_boss): final_hp -= 1; hit_boss = True
            if hit_boss: bullets.remove(b)
            else:
                # 호위기 피격
                jet_hit = False
                for jet in escort_jets[:]:
                    if b.colliderect(jet['rect']):
                        jet['hp'] -= 1
                        if jet['hp'] <= 0:
                            explosions.append([jet['rect'].centerx, jet['rect'].centery, 20])
                            escort_jets.remove(jet)
                        bullets.remove(b); jet_hit = True; break
                if jet_hit: continue
                for e in enemies[:]:
                    if b.colliderect(e):
                        enemies.remove(e); score += 30
                        explosions.append([e.centerx, e.centery, 10]); bullets.remove(b); break

        for m in missiles[:]:
            hit_boss = False
            if boss1 and m.colliderect(boss1): boss1_hp -= 15; hit_boss = True
            elif boss2 and m.colliderect(boss2): boss2_hp -= 15; hit_boss = True
            elif final_boss and m.colliderect(final_boss): final_hp -= 15; hit_boss = True
            if hit_boss: explosions.append([m.centerx, m.top, 40]); missiles.remove(m)
            else:
                # 호위기 미사일 피격
                jet_hit = False
                for jet in escort_jets[:]:
                    if m.colliderect(jet['rect']):
                        explosions.append([jet['rect'].centerx, jet['rect'].centery, 40])
                        if jet in escort_jets: escort_jets.remove(jet)
                        missiles.remove(m); jet_hit = True; break
                if jet_hit: continue
                for e in enemies[:]:
                    if m.colliderect(e):
                        enemies.remove(e); score += 30
                        explosions.append([e.centerx, e.centery, 40]); missiles.remove(m); break

        if lives <= 0:
            if tankmove_channel: tankmove_channel.stop()
            if show_end_screen("GAME OVER", "Press R to Restart / Q to Quit", RED): return

        if boss1 and boss1_hp <= 0: boss1 = None; score += 50; boss1_bombs.clear()
        if boss2 and boss2_hp <= 0: boss2 = None; score += 100; boss2_bombs.clear()
        if final_boss and final_hp <= 0:
            escort_jets.clear()
            if tankmove_channel: tankmove_channel.stop()
            if show_end_screen("MISSION COMPLETE", "Press R to Play Again", BLUE): return

        # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        # 그리기
        # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        screen.fill(SAND_COLOR)
        for p in sand_particles: pygame.draw.circle(screen, SAND_DUST, (p[0], p[1]), 2)

        if boss1:
            screen.blit(boss1_frames[ani_idx], boss1_frames[ani_idx].get_rect(center=boss1.center))
            pygame.draw.rect(screen, RED, (WIDTH//2-160, 20, int(320*(max(0, boss1_hp/boss1_max))), 12))
            pygame.draw.rect(screen, WHITE, (WIDTH//2-160, 20, 320, 12), 1)
        if boss2:
            screen.blit(boss2_frames[ani_idx], boss2_frames[ani_idx].get_rect(center=boss2.center))
            pygame.draw.rect(screen, GREEN, (WIDTH//2-160, 20, int(320*(max(0, boss2_hp/boss2_max))), 12))
            pygame.draw.rect(screen, WHITE, (WIDTH//2-160, 20, 320, 12), 1)
        if final_boss:
            screen.blit(boss3_frames[ani_idx], boss3_frames[ani_idx].get_rect(center=final_boss.center))
            pygame.draw.rect(screen, BLUE, (WIDTH//2-160, 20, int(320*(max(0, final_hp/final_max))), 16))
            pygame.draw.rect(screen, WHITE, (WIDTH//2-160, 20, 320, 16), 1)
            # 호위 전투기 그리기
            for jet in escort_jets:
                screen.blit(escort_frames[ani_idx], escort_frames[ani_idx].get_rect(center=jet['rect'].center))
                # HP 바 (작게)
                hp_w = int(80 * jet['hp'] / 3)
                pygame.draw.rect(screen, (80,80,80), (jet['rect'].centerx - 40, jet['rect'].top - 12, 80, 6))
                pygame.draw.rect(screen, GREEN, (jet['rect'].centerx - 40, jet['rect'].top - 12, hp_w, 6))

        if invul_timer % 10 < 5:
            screen.blit(player_frames[ani_idx if moving else 3], (player.centerx-130, player.centery-130))

        for e in enemies: screen.blit(enemy_frames[ani_idx], enemy_frames[ani_idx].get_rect(center=e.center))
        for b in bullets: pygame.draw.rect(screen, YELLOW, b)

        for m in missiles:
            target_rect = ammo_img.get_rect(center=m.center)
            screen.blit(ammo_img, target_rect)

        for b_data in boss1_bombs: pygame.draw.circle(screen, RED, b_data[0].center, 10)
        for b_data in boss2_bombs: pygame.draw.circle(screen, GREEN, b_data[0].center, 12)
        for b_data in final_bullets: pygame.draw.circle(screen, YELLOW, b_data[0].center, 8)

        for m_data in final_missiles:
            target_rect = boss3_ammo_img.get_rect(center=m_data[0].center)
            screen.blit(boss3_ammo_img, target_rect)

        for ex in explosions[:]:
            pygame.draw.circle(screen, ORANGE, (ex[0], ex[1]), int(ex[2]))
            ex[2] += 3
            if ex[2] > 60: explosions.remove(ex)

        # UI
        screen.blit(font.render(f"Score: {score}  |  Level: {level}", True, (40, 20, 0)), (32, 32))
        screen.blit(font.render(f"Score: {score}  |  Level: {level}", True, YELLOW), (30, 30))
        screen.blit(font.render("♥ " * lives, True, RED), (30, 70))

        ui_bg = pygame.Surface((WIDTH, 50), pygame.SRCALPHA)
        ui_bg.fill((0, 0, 0, 100))
        screen.blit(ui_bg, (0, HEIGHT-50))
        screen.blit(font_small.render("ARROWS: Move | SPACE: Fire | E: Missile | F: Shield", True, WHITE), (30, HEIGHT-36))

        skill_info = [("E", skill_cd, FPS*12, RED), ("F", shield_cd, FPS*10, BLUE)]
        for i, (label, cd, max_cd, color) in enumerate(skill_info):
            bx, by = WIDTH - 160 + (i*75), HEIGHT - 120
            pygame.draw.rect(screen, (30, 30, 50), (bx, by, 55, 55), 0, 5)
            pygame.draw.rect(screen, WHITE, (bx, by, 55, 55), 1, 5)
            if cd > 0:
                h = int(55 * (cd/max_cd))
                s = pygame.Surface((55, h), pygame.SRCALPHA)
                s.fill((*color, 180))
                screen.blit(s, (bx, by + 55 - h))
                screen.blit(font.render(str(max(0, cd//FPS+1)), True, WHITE), (bx+18, by+14))
            else:
                screen.blit(font.render(label, True, WHITE), (bx+18, by+14))

        if shield > 0:
            pygame.draw.arc(screen, BLUE, (player.x-20, player.y-20, 80, 80), 0, 3.14, 4)

        pygame.display.flip()

if __name__ == "__main__":
    while True:
        result = show_intro()
        if result == "play":
            main()

