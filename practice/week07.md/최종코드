def load_sound(filename, volume=0.18):
    try:
        path = os.path.join(os.path.dirname(__file__), filename)
        snd = pygame.mixer.Sound(path)
        snd.set_volume(volume)
        return snd
    except Exception as e:
        print(f"사운드 로드 실패 {filename}: {e}")
        return None

