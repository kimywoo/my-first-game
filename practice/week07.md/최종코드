def load_frames(filename, size):
    path = os.path.join(os.path.dirname(__file__), filename)
    if not os.path.exists(path):
        frames = []
        for _ in range(4):
            dummy = pygame.Surface(size, pygame.SRCALPHA)
            pygame.draw.rect(dummy, GRAY, (0, 0, size[0], size[1]), 2)
            frames.append(dummy)
        return frames
    try:
        sheet = pygame.image.load(path).convert_alpha()
        sw, sh = sheet.get_size()
        fw, fh = sw // 2, sh // 2
        frames = []
        for i in range(4):
            row, col = divmod(i, 2)
            rect = pygame.Rect(col * fw, row * fh, fw, fh)
            frames.append(pygame.transform.scale(sheet.subsurface(rect), size))
        return frames
    except:
        surf = pygame.Surface(size, pygame.SRCALPHA)
        return [surf] * 4

def load_boss2_from_b64(b64_str, size):
    try:
        sheet_bytes = base64.b64decode(b64_str)
        sheet = pygame.image.load(io.BytesIO(sheet_bytes)).convert_alpha()
        fw, fh = 200, 200
        frames = []
        for i in range(4):
            row, col = divmod(i, 2)
            rect = pygame.Rect(col * fw, row * fh, fw, fh)
            frames.append(pygame.transform.scale(sheet.subsurface(rect), size))
        return frames
    except:
        return load_frames("boss2.png", size)

