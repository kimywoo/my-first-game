def draw_desert_bg_intro(tick):
    """사막 인트로 배경 - 황토색 모래언덕"""
    # 하늘 그라데이션
    for y in range(HEIGHT // 2):
        ratio = y / (HEIGHT // 2)
        r = int(180 + ratio * 40)
        g = int(100 + ratio * 60)
        b = int(30 + ratio * 20)
        pygame.draw.line(screen, (r, g, b), (0, y), (WIDTH, y))

    # 땅
    for y in range(HEIGHT // 2, HEIGHT):
        ratio = (y - HEIGHT // 2) / (HEIGHT // 2)
        r = int(185 - ratio * 20)
        g = int(140 - ratio * 20)
        b = int(85 - ratio * 15)
        pygame.draw.line(screen, (r, g, b), (0, y), (WIDTH, y))

    # 모래언덕들
    dune_data = [(0, HEIGHT//2 + 80, 500, 140), (400, HEIGHT//2 + 40, 700, 180),
                 (900, HEIGHT//2 + 60, 600, 160), (1400, HEIGHT//2 + 50, 700, 170),
                 (1800, HEIGHT//2 + 80, 400, 130)]
    for (dx, dy, dw, dh) in dune_data:
        pts = [(dx, HEIGHT), (dx + dw//2, dy), (dx + dw, HEIGHT)]
        pygame.draw.polygon(screen, (200, 155, 95), pts)
        pygame.draw.polygon(screen, (215, 170, 110), [(dx, HEIGHT), (dx + dw//2, dy), (dx + dw//2 + 30, dy + 20), (dx, HEIGHT)])

    # 움직이는 모래 입자
    random.seed(tick // 4)
    for _ in range(60):
        px = random.randint(0, WIDTH)
        py = random.randint(HEIGHT//2, HEIGHT)
        pygame.draw.circle(screen, (220, 185, 130), (px, py), random.randint(1, 3))

    # 태양
    sun_x, sun_y = WIDTH - 180, 120
    for r in range(80, 30, -5):
        alpha_ratio = (80 - r) / 50
        color = (255, int(200 + alpha_ratio * 55), int(alpha_ratio * 80))
        pygame.draw.circle(screen, color, (sun_x, sun_y), r)
    pygame.draw.circle(screen, (255, 240, 180), (sun_x, sun_y), 50)

def show_intro():
    play_intro_music()

    try:
        logo_path = os.path.join(os.path.dirname(__file__), "intro.png")
        logo_img = pygame.image.load(logo_path).convert_alpha()
        logo_img = pygame.transform.scale(logo_img, (1100, 480))  # 더 크게
    except:
        logo_img = None

    menu_items = ["PLAY", "CREDIT", "QUIT"]
    selected = 0
    tick = 0

    while True:
        tick += 1
        draw_desert_bg_intro(tick)

        # 로고
        if logo_img:
            logo_rect = logo_img.get_rect(center=(WIDTH // 2, 300))
            screen.blit(logo_img, logo_rect)
        else:
            # 황토빛 텍스트 그림자
            shadow = font_big.render("DESERT TANK", True, (120, 70, 10))
            screen.blit(shadow, shadow.get_rect(center=(WIDTH // 2 + 4, 304)))
            title = font_big.render("DESERT TANK", True, YELLOW)
            screen.blit(title, title.get_rect(center=(WIDTH // 2, 300)))

        # 메뉴 배경 반투명
        menu_bg = pygame.Surface((500, 360), pygame.SRCALPHA)
        menu_bg.fill((20, 10, 0, 140))
        screen.blit(menu_bg, menu_bg.get_rect(center=(WIDTH // 2, 700)))

        # 메뉴 버튼
        for i, item in enumerate(menu_items):
            if i == selected:
                color = YELLOW
                size = 64
            else:
                color = (200, 170, 120)
                size = 52

            try:
                f = pygame.font.SysFont("malgungothic", size, bold=(i == selected))
            except:
                f = pygame.font.SysFont("arial", size, bold=(i == selected))

            text = f.render(item, True, color)
            rect = text.get_rect(center=(WIDTH // 2, 590 + i * 110))
            screen.blit(text, rect)

            if i == selected:
                arrow = f.render("▶", True, YELLOW)
                screen.blit(arrow, (rect.left - 60, rect.top))

        guide = font_small.render("↑↓ 방향키로 선택   ENTER로 확인", True, (180, 150, 100))
        screen.blit(guide, guide.get_rect(center=(WIDTH // 2, 1020)))

        pygame.display.flip()
        clock.tick(FPS)

        for e in pygame.event.get():
            if e.type == pygame.QUIT:
                pygame.quit(); sys.exit()
            if e.type == pygame.KEYDOWN:
                if e.key == pygame.K_UP:
                    selected = (selected - 1) % len(menu_items)
                if e.key == pygame.K_DOWN:
                    selected = (selected + 1) % len(menu_items)
                if e.key == pygame.K_RETURN:
                    if selected == 0:
                        pygame.mixer.music.stop()
                        screen.fill(BLACK)  # 잔상 제거
                        pygame.display.flip()
                        pygame.time.delay(80)
                        return "play"
                    elif selected == 1:
                        show_credit()
                    elif selected == 2:
                        pygame.quit(); sys.exit()

