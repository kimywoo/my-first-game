# WARNING 애니메이션 (파이널 보스)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
def show_final_boss_warning():
    """BGM 페이드아웃 → WARNING 배너 + shadow.png 웅장하게 내려오기 → 보스 BGM"""
    # BGM 서서히 페이드아웃
    for vol in range(30, -1, -2):
        pygame.mixer.music.set_volume(vol / 100)
        pygame.time.delay(20)
    pygame.mixer.music.stop()

    # shadow.png 로드 - 화면 전체보다 크게 (1400x1400)
    try:
        shadow_path = os.path.join(os.path.dirname(__file__), "shadow.png")
        shadow_img = pygame.image.load(shadow_path).convert_alpha()
        shadow_img = pygame.transform.scale(shadow_img, (1400, 1400))
    except:
        shadow_img = None

    SHADOW_W, SHADOW_H = 1400, 1400
    SHADOW_START_Y = -SHADOW_H          # 완전히 화면 위 바깥
    SHADOW_END_Y   = -SHADOW_H // 2 + 80  # 절반 정도 내려와서 상단에 걸쳐 보임

    # 줄무늬 배너 미리 생성
    stripe_w = 80
    stripe_surf = pygame.Surface((WIDTH + 300, 120), pygame.SRCALPHA)
    col_idx = 0
    for sx in range(0, WIDTH + 500, stripe_w):
        color = (200, 0, 0, 220) if col_idx % 2 == 0 else (15, 15, 15, 220)
        pts = [(sx - 30, 0), (sx - 30 + stripe_w, 0), (sx + stripe_w, 120), (sx, 120)]
        pygame.draw.polygon(stripe_surf, color, pts)
        col_idx += 1

    try:
        wf = pygame.font.SysFont("malgungothic", 110, bold=True)
        sf = pygame.font.SysFont("malgungothic", 38, bold=True)
    except:
        wf = pygame.font.SysFont("arial", 110, bold=True)
        sf = pygame.font.SysFont("arial", 38, bold=True)

    # 총 4.5초 — 그림자가 천천히 내려와 상단에 멈추는 시간 확보
    TOTAL      = int(FPS * 4.5)
    # 그림자는 처음 60% 시간 동안 내려오고 나머지는 멈춰있음
    MOVE_END_T = 0.60
    BANNER_Y   = HEIGHT // 2 - 60

    game_snapshot = screen.copy()

    for frame in range(TOTAL):
        t = frame / TOTAL  # 0.0 → 1.0

        # ── 배경: 게임 스냅샷 → 점점 검게 ──
        dark_alpha = min(int(t * 210), 210)
        screen.blit(game_snapshot, (0, 0))
        dark_overlay = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
        dark_overlay.fill((0, 0, 0, dark_alpha))
        screen.blit(dark_overlay, (0, 0))

        # ── shadow.png: 천천히 내려와서 상단에 멈춤 ──
        if shadow_img:
            # move_t: 0→1 (MOVE_END_T 이후엔 1.0 고정)
            raw_t = min(t / MOVE_END_T, 1.0)
            # ease-out cubic — 천천히 감속하며 멈추는 느낌
            ease_t = 1.0 - (1.0 - raw_t) ** 3.0

            sy = int(SHADOW_START_Y + ease_t * (SHADOW_END_Y - SHADOW_START_Y))

            # 알파: 처음 30% 동안 서서히 나타남
            alpha_t = min(t / 0.30, 1.0)
            shadow_alpha = int(alpha_t * 255)

            s_copy = shadow_img.copy()
            s_copy.set_alpha(shadow_alpha)
            screen.blit(s_copy, (WIDTH // 2 - SHADOW_W // 2, sy))

        # ── 줄무늬 배너 슬라이드인 ──
        slide_t = min(t / 0.20, 1.0)
        slide_x = int((1.0 - slide_t) * -WIDTH)

        screen.blit(stripe_surf, (slide_x, BANNER_Y - 120))
        screen.blit(stripe_surf, (slide_x, BANNER_Y + 80))
        pygame.draw.rect(screen, WHITE, (slide_x, BANNER_Y - 120, WIDTH, 120), 2)
        pygame.draw.rect(screen, WHITE, (slide_x, BANNER_Y + 80,  WIDTH, 120), 2)

        # ── WARNING 텍스트 ──
        blink_on = (frame % 26) < 20
        if blink_on:
            center_bg = pygame.Surface((WIDTH, 200), pygame.SRCALPHA)
            center_bg.fill((100, 0, 0, 190))
            screen.blit(center_bg, (0, BANNER_Y - 100))

            for ox, oy in [(-3,0),(3,0),(0,-3),(0,3),(-2,-2),(2,2)]:
                outline = wf.render("⚠  WARNING  ⚠", True, (60, 0, 0))
                screen.blit(outline, outline.get_rect(center=(WIDTH//2 + ox, BANNER_Y + oy)))
            warn_text = wf.render("⚠  WARNING  ⚠", True, (255, 55, 55))
            screen.blit(warn_text, warn_text.get_rect(center=(WIDTH // 2, BANNER_Y)))

            sub_text = sf.render("FINAL BOSS IS APPROACHING", True, (255, 200, 100))
            screen.blit(sub_text, sub_text.get_rect(center=(WIDTH // 2, BANNER_Y + 90)))

        pygame.display.flip()
        clock.tick(FPS)

        for e in pygame.event.get():
            if e.type == pygame.QUIT:
                pygame.quit(); sys.exit()

    play_boss_music()

