import pygame
import random
import sys
import os

# 1. 초기화 및 설정
pygame.init()
WIDTH, HEIGHT = 800, 600
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Tank Desert Storm - Final")
clock = pygame.time.Clock()
FPS = 60

# 색상 정의
SAND_COLOR = (210, 180, 140)
SAND_DUST = (194, 161, 113)
WHITE = (255, 255, 255)
RED = (220, 50, 50)
YELLOW = (240, 220, 0)
BLUE = (50, 150, 255)
GRAY = (50, 50, 50)

# 폰트 설정
try:
    font = pygame.font.SysFont("malgungothic", 20)
    font_big = pygame.font.SysFont("malgungothic", 60)
except:
    font = pygame.font.SysFont("arial", 20)
    font_big = pygame.font.SysFont("arial", 60)

# 2. 이미지 로드 (직접 경로 지정)
BASE_PATH = os.path.dirname(os.path.abspath(__file__))
# asset 폴더 안의 ww2.png를 직접 가리킴
IMAGE_PATH = os.path.join(BASE_PATH, "asset", "ww2.png")

try:
    full_sheet = pygame.image.load(IMAGE_PATH).convert_alpha()
    
    # 탱크 애니메이션 프레임 자르기 (100x100 크기, 2열 2행 기준)
    tank_frames = []
    FRAME_W, FRAME_H = 100, 100
    for i in range(4):
        row, col = divmod(i, 2)
        rect = pygame.Rect(col * FRAME_W, row * FRAME_H, FRAME_W, FRAME_H)
        frame = full_sheet.subsurface(rect)
        # 탱크 크기 조절 (80x80)
        tank_frames.append(pygame.transform.scale(frame, (80, 80)))
except Exception as e:
    print(f"파일을 불러올 수 없습니다: {IMAGE_PATH}")
    print("에러 내용:", e)
    pygame.quit()
    sys.exit()

# 3. 게임 오버 화면
def show_game_over():
    while True:
        screen.fill((30, 20, 10))
        msg = font_big.render("MISSION FAILED", True, RED)
        retry = font.render("Press 'R' to Restart or 'Q' to Quit", True, WHITE)
        screen.blit(msg, (WIDTH//2 - msg.get_width()//2, HEIGHT//2 - 50))
        screen.blit(retry, (WIDTH//2 - retry.get_width()//2, HEIGHT//2 + 40))
        pygame.display.flip()
        
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_r:
                    return # 다시 시작
                if event.key == pygame.K_q:
                    pygame.quit()
                    sys.exit()

# 4. 메인 게임 루프
def play_game():
    # 플레이어 설정
    player_rect = pygame.Rect(WIDTH//2 - 20, HEIGHT - 100, 40, 40)
    bullets = []
    enemies = []
    explosions = []
    
    score = 0
    lives = 3
    shoot_cd = 0
    shield_timer = 0
    shield_cd = 0
    skill_cd = 0
    
    # 애니메이션 변수
    ani_index = 0
    ani_timer = 0
    
    # 배경 입자
    particles = [[random.randint(0, WIDTH), random.randint(0, HEIGHT)] for _ in range(100)]

    while True:
        screen.fill(SAND_COLOR)
        dt = clock.tick(FPS)
        
        # 이벤트 처리
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()

        # 조작
        keys = pygame.key.get_pressed()
        if keys[pygame.K_LEFT] and player_rect.left > 0: player_rect.x -= 6
        if keys[pygame.K_RIGHT] and player_rect.right < WIDTH: player_rect.x += 6
        if keys[pygame.K_UP] and player_rect.top > 0: player_rect.y -= 6
        if keys[pygame.K_DOWN] and player_rect.bottom < HEIGHT: player_rect.y += 6

        # 애니메이션 타이머
        ani_timer += dt
        if ani_timer > 150:
            ani_index = (ani_index + 1) % 4
            ani_timer = 0

        # 공격 (스페이스바) - 노란색 단발 포탄
        shoot_cd -= 1
        if keys[pygame.K_SPACE] and shoot_cd <= 0:
            bullets.append(pygame.Rect(player_rect.centerx - 3, player_rect.top - 10, 6, 15))
            shoot_cd = 15

        # 방어막 (F키) - 반원
        shield_cd -= 1
        if keys[pygame.K_f] and shield_cd <= 0:
            shield_timer = 180 # 3초 (60fps * 3)
            shield_cd = 600 # 10초 쿨타임

        # 배경 그리기 (모래 흐름)
        for p in particles:
            p[1] += 2
            if p[1] > HEIGHT:
                p[1] = 0
                p[0] = random.randint(0, WIDTH)
            pygame.draw.circle(screen, SAND_DUST, p, 1)

        # 적 생성
        if random.random() < 0.02:
            enemies.append(pygame.Rect(random.randint(0, WIDTH-40), -40, 40, 40))

        # 투사체 이동
        for b in bullets[:]:
            b.y -= 10
            if b.bottom < 0: bullets.remove(b)
            else: pygame.draw.rect(screen, YELLOW, b)

        # 적 이동 및 충돌
        for e in enemies[:]:
            e.y += 4
            if e.top > HEIGHT:
                enemies.remove(e)
                continue
            
            # 플레이어와 충돌
            if e.colliderect(player_rect):
                enemies.remove(e)
                if shield_timer <= 0:
                    lives -= 1
                explosions.append([e.centerx, e.centery, 20])
                continue

            # 포탄과 충돌
            for b in bullets[:]:
                if e.colliderect(b):
                    if b in bullets: bullets.remove(b)
                    if e in enemies: enemies.remove(e)
                    score += 10
                    explosions.append([e.centerx, e.centery, 20])
                    break
            
            # 적 그리기 (삼각형)
            pygame.draw.polygon(screen, RED, [(e.centerx, e.bottom), (e.left, e.top), (e.right, e.top)])

        # 폭발 효과 그리기
        for ex in explosions[:]:
            pygame.draw.circle(screen, (255, 100, 0), (ex[0], ex[1]), ex[2])
            ex[2] -= 1
            if ex[2] <= 0: explosions.remove(ex)

        # 플레이어 탱크 그리기
        curr_tank = tank_frames[ani_index]
        screen.blit(curr_tank, (player_rect.centerx - 40, player_rect.centery - 40))

        # 방어막 그리기 (반원)
        if shield_timer > 0:
            shield_timer -= 1
            pygame.draw.arc(screen, BLUE, (player_rect.x - 20, player_rect.y - 20, 80, 80), 0, 3.14, 4)

        # UI 그리기
        screen.blit(font.render("ARROW Move / SPACE Shoot / F Shield", True, GRAY), (10, 10))
        screen.blit(font.render(f"SCORE: {score}", True, GRAY), (10, 35))
        screen.blit(font.render("♥ " * lives, True, RED), (10, 60))

        # 스킬 아이콘 UI
        f_box = pygame.Rect(WIDTH - 60, HEIGHT - 60, 45, 45)
        pygame.draw.rect(screen, (100, 90, 70), f_box)
        screen.blit(font.render("F", True, WHITE), (f_box.x + 15, f_box.y + 10))
        if shield_cd > 0:
            cd_txt = font.render(str(shield_cd // 60 + 1), True, BLUE)
            screen.blit(cd_txt, (f_box.x + 15, f_box.y + 10))

        if lives <= 0:
            show_game_over()
            return # main 다시 시작

        pygame.display.flip()

# 실행부
while True:
    play_game()
